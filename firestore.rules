rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'bohlehsaurus7@gmail.com';
    }

    function isMonitor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/monitors/$(request.auth.uid));
    }

    // Any authenticated user can read profiles.
    // Own profile, admin, friends removing themselves, or monitors writing suspendedUntil only.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        (
          request.auth.uid in resource.data.get('friends', []) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
          !request.resource.data.friends.hasAll([request.auth.uid])
        ) ||
        (
          isMonitor() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspendedUntil'])
        )
      );

      match /notifications/{notifId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
      }
    }

    // Monitors collection: any logged-in user can read (needed to assign reports),
    // only admin can write.
    match /monitors/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Reports: any logged-in user can create, reporter/assignedMonitor/admin can read+update.
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        isAdmin() ||
        resource.data.reporterUid == request.auth.uid ||
        resource.data.assignedMonitorUid == request.auth.uid
      );
    }

    // Notifications: any logged-in user can create, only the recipient can read/update.
    match /notifications/{notifId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null &&
        resource.data.toUid == request.auth.uid;
    }

    // Servers
    match /servers/{serverId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
                       resource.data.ownerId == request.auth.uid;

      match /channels/{channelId} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId ||
          request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.get('members', [])
        );

        match /messages/{messageId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && (
            request.resource.data.uid == request.auth.uid ||
            request.resource.data.type == 'bot' ||
            request.resource.data.type == 'system'
          );
          allow update: if request.auth != null && (
            resource.data.uid == request.auth.uid ||
            resource.data.type == 'poll' ||
            resource.data.type == 'chess-live' ||
            resource.data.type == 'uno' ||
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reactions', 'important', 'pinned'])
          );
          allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
        }

        match /swearCounts/{uid} {
          allow read, write: if request.auth != null;
        }
      }

      match /categories/{categoryId} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId ||
          request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.get('members', [])
        );
      }
    }

    // DMs: only the two participants can read or write.
    match /dms/{dmId} {
      allow read, write: if request.auth != null && dmId.split('_').hasAny([request.auth.uid]);

      match /messages/{messageId} {
        allow read: if request.auth != null && dmId.split('_').hasAny([request.auth.uid]);
        allow create: if request.auth != null &&
          dmId.split('_').hasAny([request.auth.uid]) &&
          request.resource.data.uid == request.auth.uid;
        allow update: if request.auth != null &&
          dmId.split('_').hasAny([request.auth.uid]) && (
            resource.data.uid == request.auth.uid ||
            resource.data.type == 'poll'
          );
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }

    // Friend requests: sender or recipient can read/write.
    match /friendRequests/{reqId} {
      allow read: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid   == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid   == request.auth.uid
      );
    }

    // Server invites: sender or recipient can read/write.
    match /serverInvites/{inviteId} {
      allow read: if request.auth != null && (
        resource.data.toUid   == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.toUid   == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
    }

    // Calls: any authenticated user can read/write (needed for WebRTC signaling).
    match /calls/{callId} {
      allow read, write: if request.auth != null;

      match /signals/{signalId} {
        allow read, write: if request.auth != null;
      }
    }

  }
}
