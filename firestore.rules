rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────────
    // Anyone logged in can read profiles; only you can edit your own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'bohlehsaurus7@gmail.com'
      );

      // Notifications are private — only the owner can see/clear them
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Servers / Groups ───────────────────────────────────────────────────────
    match /servers/{serverId} {
      // Any authenticated user can read (needed for join-by-URL ban check)
      allow read: if request.auth != null;
      // Any authenticated user can create a server or update membership
      allow create, update: if request.auth != null;
      // Only the owner can delete a server
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // ── Channels ────────────────────────────────────────────────────────────
      match /channels/{channelId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId ||
          request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.members
        );

        // ── Messages ──────────────────────────────────────────────────────────
        match /messages/{messageId} {
          allow read: if request.auth != null;
          // You can only post a message with your own uid
          allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
          // You can only edit or delete your own messages
          allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
        }
      }

      // ── Channel headers / categories ─────────────────────────────────────────
      match /categories/{categoryId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId ||
          request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.members
        );
      }
    }

    // ── DMs ────────────────────────────────────────────────────────────────────
    // dmId is "uid1_uid2" (sorted) — ONLY the two people in the DM can access it
    match /dms/{dmId} {
      allow read, write: if request.auth != null && dmId.split('_').hasAny([request.auth.uid]);

      match /messages/{messageId} {
        allow read: if request.auth != null && dmId.split('_').hasAny([request.auth.uid]);
        allow create: if request.auth != null &&
          dmId.split('_').hasAny([request.auth.uid]) &&
          request.resource.data.uid == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }

    // ── Friend Requests ────────────────────────────────────────────────────────
    match /friendRequests/{reqId} {
      allow read: if request.auth != null && (
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
    }

    // ── Server Invites ─────────────────────────────────────────────────────────
    match /serverInvites/{inviteId} {
      allow read: if request.auth != null && (
        resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid
      );
    }

    // ── Calls ──────────────────────────────────────────────────────────────────
    // Call signaling needs fast read/write for all call participants
    match /calls/{callId} {
      allow read, write: if request.auth != null;
    }
  }
}
