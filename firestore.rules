rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read any profile, but only write their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Servers
    match /servers/{serverId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members;
      allow create: if request.auth != null;
      // Only members can update (e.g. join)
      allow update: if request.auth != null &&
        (request.auth.uid in resource.data.members ||
         request.auth.uid == request.resource.data.members[request.resource.data.members.size() - 1]);

      // Channels — readable/writable by server members only
      match /channels/{channelId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.members;

        // Messages
        match /messages/{messageId} {
          allow read: if request.auth != null &&
            request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.members;
          allow create: if request.auth != null &&
            request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.members &&
            request.resource.data.uid == request.auth.uid;
          allow update, delete: if request.auth != null &&
            request.auth.uid == resource.data.uid;
        }
      }
    }
  }
}
